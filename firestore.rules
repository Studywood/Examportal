rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() &&
        request.auth.token.email == "abhi.admin@examportal.app";
    }

    match /users/{uid} {
      allow read, create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
    }

    match /tests/{testId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /results/{resultId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() &&
        (resource.data.uid == request.auth.uid || admin());
      allow update, delete: if admin();
    }
  }
}
